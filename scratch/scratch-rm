#!/bin/sh
# scratch-rm PATH... — delete each PATH, as rm -rf would, when it lies strictly inside this Claude Code
# session's scratch root, /tmp/cs/<CLAUDE_CODE_SESSION_ID>/. Never reads TMPDIR. Every PATH is checked
# before anything is deleted; one refusal deletes nothing. A missing PATH in an existing folder is skipped,
# as rm -f would; a PATH whose folder is missing is refused, since that folder cannot be checked.
# It guards against its arguments, not against another process of the same user renaming folders while
# it runs: such a process can delete anything itself (plan 0041 § Left open).
# Plan 0041.
PATH=/usr/bin:/bin; export PATH
unset CDPATH
. "$(dirname "$0")/common.sh"

refuse() { echo "scratch-rm: $*; nothing deleted" >&2; exit 2; }

sid=${CLAUDE_CODE_SESSION_ID-}
is_session_id "$sid" || refuse "CLAUDE_CODE_SESSION_ID is missing or not a session id"
own_dir "$BASE" && own_dir "$BASE/$sid" || refuse "$BASE/$sid is not this user's own folder"
real_base=$(cd "$BASE" && pwd -P) || refuse "cannot resolve $BASE"
root=$real_base/$sid
[ $# -gt 0 ] || refuse "usage: scratch-rm PATH... (paths inside $BASE/$sid/)"

# resolve PATH: set $parent (PATH's folder, resolved with pwd -P) and $name (its last component), or set
# $err and fail when PATH is outside root.
resolve() {
    case $1 in -*) err="options are not accepted: $1 (write ./$1)"; return 1 ;; esac
    name=$(basename -- "$1") && dir=$(dirname -- "$1") || { err="cannot parse: $1"; return 1; }
    case $name in .|..|/) err="refusing $1: it names a folder by . or .. or /"; return 1 ;; esac
    parent=$(cd -- "$dir" 2>/dev/null && pwd -P) || { err="no such folder: $dir"; return 1; }
    inside "$parent" || { err="outside $BASE/$sid/: $1"; return 1; }
}

# inside DIR: true when DIR is the root or a folder below it.
inside() {
    case $1/ in "$root"/*) return 0 ;; *) return 1 ;; esac
}

for p in "$@"; do
    resolve "$p" || refuse "$err"
done
# Delete from inside the checked folder, re-checked there, so that a folder above it swapped for a symlink
# after the check cannot redirect the delete: ./NAME is looked up in the folder the shell is standing in.
for p in "$@"; do
    resolve "$p" || refuse "$err"
    (cd -P -- "$parent" && inside "$(pwd -P)" && rm -rf -- "./$name") || exit 1
done
